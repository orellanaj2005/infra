# Copiar a .env (no se sube a GitHub) y completar los dos valores de Azure AD.

# Azure AD (Entra ID): tenant y client ID de RutaExpress-API. Pedírselos a Javier.
TENANT_ID=
API_CLIENT_ID=

# Mensajería: nombres de servicio dentro de la red del proyecto.
RABBITMQ_ADDRESSES=rabbit1:5672,rabbit2:5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_MGMT_URL=http://rabbit1:15672
RABBITMQ_MGMT_USER=guest
RABBITMQ_MGMT_PASSWORD=guest
KAFKA_BOOTSTRAP_SERVERS=kafka1:29092,kafka2:29092,kafka3:29092

# Oracle (cada servicio usa su propio usuario por defecto).
ORACLE_HOST=oracle-db
ORACLE_PORT=1521
ORACLE_SERVICE=XEPDB1
DB_HOST=oracle-db
DB_PORT=1521
DB_SERVICE=XEPDB1
